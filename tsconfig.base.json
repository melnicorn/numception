{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": [],
    "composite": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "rootDir": "${configDir}",
    "outDir": "${configDir}/.tsbuild"
  }
}
