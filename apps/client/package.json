{
  "name": "@numception/client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "cap:sync": "BASE_PATH= vite build && cap sync",
    "cap:sync:phaser": "pnpm --filter @numception/bakeoff-phaser run build && BAKEOFF=phaser cap sync",
    "cap:sync:pixi": "pnpm --filter @numception/bakeoff-pixi run build && BAKEOFF=pixi cap sync"
  },
  "dependencies": {
    "@capacitor/android": "~8.5.3",
    "@capacitor/core": "~8.5.3",
    "@capacitor/ios": "~8.5.3",
    "@numception/ui": "workspace:*"
  },
  "devDependencies": {
    "@capacitor/cli": "~8.5.3",
    "@preact/preset-vite": "~2.10.6",
    "preact": "~10.29.8",
    "vite": "~8.3.4"
  }
}
