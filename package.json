{
  "name": "numception",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -b",
    "lint:deps": "depcruise packages apps/client/src --config .dependency-cruiser.cjs && node tools/check-supply.mjs",
    "test": "vitest run",
    "build": "pnpm --filter @numception/client run build:all",
    "check:flavours": "node tools/check-flavours.mjs",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "~1.64.0",
    "@types/node": "~24.19.1",
    "dependency-cruiser": "~18.5.0",
    "typescript": "~6.0.3",
    "vitest": "~5.0.3"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.18.0",
      "onFail": "download"
    }
  }
}
